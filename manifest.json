{
  "manifest_version": 2,
  "name": "VideoEnhancer",
  "version": "1.0",
  "description": "Enhance your videos, fight glare, see more!",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "browser_action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icon.svg"
    },
    "default_title": "VideoEnhancer"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "48": "icon.svg"
  }
}
